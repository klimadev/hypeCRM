{
  "name": "hype-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3434",
    "build": "next build",
    "build:strict": "NEXT_STRICT_BUILD=1 next build",
    "start": "next start -H 0.0.0.0 -p 3434",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "seed": "prisma db seed",
    "setup": "node scripts/setup-wizard.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --only hypecrm-web",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.cjs --only hypecrm-web --update-env",
    "pm2:logs": "pm2 logs hypecrm-web --lines 100",
    "pm2:list": "pm2 list",
    "pm2:delete": "pm2 delete hypecrm-web >/dev/null 2>&1 || true",
    "pm2:save": "pm2 save",
    "screenshot:pricing": "node scripts/pricing-screenshots.js",
    "screenshot:pricing:mobile": "node scripts/pricing-screenshots.js --mobile",
    "migrate:lead-negocio:backfill": "tsx prisma/scripts/backfill-leads-para-negocios.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reactour/tour": "^3.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/estree": "^1.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
