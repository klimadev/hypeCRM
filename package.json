{
  "name": "hype-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3434",
    "build": "next build",
    "clean:next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "start": "next start -H 0.0.0.0 -p 3434",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "NODE_ENV=test vitest run --config vitest.config.ts",
    "test:watch": "NODE_ENV=test vitest --config vitest.config.ts",
    "test:coverage": "NODE_ENV=test vitest run --config vitest.config.ts --coverage",
    "seed": "prisma db seed",
    "setup": "node scripts/setup-wizard.js",
    "deploy": "next build && systemctl restart hypecrm-web hypecrm-chat-scheduler"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/estree": "^1.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
