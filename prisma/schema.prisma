generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Empresa {
  id                String         @id @default(uuid())
  nome              String
  email             String         @unique
  senha_hash        String
  criado_em         DateTime       @default(now())
  atualizado_em     DateTime       @default(now()) @updatedAt
  status_assinatura String         @default("TRIAL")
  trial_inicio      DateTime       @default(now())
  trial_fim         DateTime?
  assinatura_inicio DateTime?
  assinatura_fim    DateTime?
  plano             String         @default("trial")
  estagios          EstagioFunil[]
  funcionarios      Funcionario[]
  leads             Lead[]
  metas             Meta[]
  metasProgresso    MetaProgresso[]
  produtos          Produto[]
  leads_produto     LeadProduto[]
  pdvs              Pdv[]
  parcelas          Parcela[]
  automacoes        Automacao[]
  registros_ip      RegistroIP[]
}

model Pdv {
  id                    String             @id @default(uuid())
  id_empresa            String
  id_whatsapp_instancia String?
  nome                  String
  criado_em             DateTime           @default(now())
  atualizado_em         DateTime           @default(now()) @updatedAt
  funcionarios          Funcionario[]
  metas                 Meta[]
  empresa               Empresa            @relation(fields: [id_empresa], references: [id])
  whatsapp_instancia    WhatsappInstancia? @relation(fields: [id_whatsapp_instancia], references: [id], onDelete: SetNull)

  @@index([id_empresa])
  @@index([id_empresa, id_whatsapp_instancia])
}

model Funcionario {
  id            String    @id @default(uuid())
  id_empresa    String
  id_pdv        String
  nome          String
  email         String    @unique
  senha_hash    String
  cargo         String
  ativo         Boolean   @default(true)
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @default(now()) @updatedAt
  inativado_em  DateTime?
  metas         Meta[]
  pdv           Pdv       @relation(fields: [id_pdv], references: [id])
  empresa       Empresa   @relation(fields: [id_empresa], references: [id])
  leads         Lead[]

  @@index([id_empresa])
  @@index([id_pdv])
}

model ReatribuicaoFuncionario {
  id                     String   @id @default(uuid())
  id_empresa             String
  id_funcionario_origem  String
  id_funcionario_destino String
  quantidade_leads       Int
  observacao             String?
  criado_por_tipo        String
  criado_por_id          String
  criado_em              DateTime @default(now())

  @@index([id_empresa])
  @@index([id_funcionario_origem])
  @@index([id_funcionario_destino])
}

model AuditoriaEquipe {
  id                  String   @id @default(uuid())
  id_empresa          String
  id_funcionario_alvo String
  acao                String
  campo               String?
  valor_anterior      String?
  valor_novo          String?
  observacao          String?
  autor_tipo          String
  autor_id            String
  criado_em           DateTime @default(now())

  @@index([id_empresa])
  @@index([id_funcionario_alvo])
  @@index([acao])
}

model EstagioFunil {
  id            String   @id @default(uuid())
  id_empresa    String
  nome          String
  ordem         BigInt
  tipo          String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @default(now()) @updatedAt
  empresa       Empresa  @relation(fields: [id_empresa], references: [id])
  leads         Lead[]

  @@unique([id_empresa, ordem])
  @@index([id_empresa])
}

model Lead {
  id                      String             @id @default(uuid())
  id_empresa              String
  id_funcionario          String
  id_estagio              String
  nome                    String
  telefone                String
  email                   String?
  valor_oportunidade      Float              @default(0)
  probabilidade           Float             @default(0.5)  // 0-100%
  fonte                   String?            // De onde veio o lead
  empresa_origem          String?            // Para B2B
  observacoes             String?
  motivo_perda            String?
  criado_em               DateTime           @default(now())
  atualizado_em           DateTime           @default(now()) @updatedAt
  origem                  String             @default("MANUAL")
  // Campos para anúncios CTWA (Click to WhatsApp)
  anuncio_titulo         String?
  anuncio_descricao      String?
  anuncio_url            String?
  dados_extras           String?              // Campos customizáveis (JSON serializado)
  estagio                 EstagioFunil       @relation(fields: [id_estagio], references: [id])
  funcionario             Funcionario        @relation(fields: [id_funcionario], references: [id])
  empresa                 Empresa            @relation(fields: [id_empresa], references: [id])
  produtos                LeadProduto[]
  pendencias              Pendencia[]
  parcelas                Parcela[]
  whatsapp_mensagens      WhatsappMensagem[]
  estagio_logs            LeadEstagioLog[]
  automacao_agendamentos  AutomacaoAgendamento[]

  @@index([id_empresa])
  @@index([id_funcionario])
  @@index([id_estagio])
  @@index([id_empresa, email])
}

model Produto {
  id             String       @id @default(uuid())
  id_empresa     String
  nome           String
  slug           String
  descricao      String?
  ativo          Boolean      @default(true)
  schema_layout  String
  criado_em      DateTime     @default(now())
  atualizado_em  DateTime     @default(now()) @updatedAt
  empresa        Empresa      @relation(fields: [id_empresa], references: [id])
  leads_produto  LeadProduto[]

  @@unique([id_empresa, slug])
  @@index([id_empresa])
  @@index([id_empresa, ativo])
}

model LeadProduto {
  id              String   @id @default(uuid())
  id_empresa      String
  id_lead         String
  id_produto      String
  nome_snapshot   String
  schema_snapshot String
  valores_layout  String
  observacoes     String?
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @default(now()) @updatedAt
  empresa         Empresa  @relation(fields: [id_empresa], references: [id])
  lead            Lead     @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  produto         Produto  @relation(fields: [id_produto], references: [id])

  @@index([id_empresa])
  @@index([id_lead])
  @@index([id_produto])
}

model Parcela {
  id               String   @id @default(uuid())
  id_empresa       String
  id_lead          String
  numero_parcela   Int
  quantidade_total Int
  valor            Float
  data_vencimento  DateTime
  data_pagamento   DateTime?
  status           String   @default("PENDENTE")
  criado_em        DateTime @default(now())
  atualizado_em    DateTime @default(now()) @updatedAt

  lead    Lead    @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [id_empresa], references: [id])

  @@unique([id_lead, numero_parcela])
  @@index([id_empresa])
  @@index([id_lead])
  @@index([id_empresa, status])
  @@index([id_empresa, data_vencimento])
}

model Meta {
  id             String       @id @default(uuid())
  id_empresa     String
  tipo           String
  tipo_meta      String
  alvo           Float
  periodo        String
  data_inicio    DateTime
  data_fim       DateTime
  ativo          Boolean      @default(true)
  criado_em      DateTime     @default(now())
  atualizado_em  DateTime     @default(now()) @updatedAt
  id_pdv         String?
  id_funcionario String?

  empresa     Empresa        @relation(fields: [id_empresa], references: [id])
  pdv         Pdv?           @relation(fields: [id_pdv], references: [id])
  funcionario Funcionario?   @relation(fields: [id_funcionario], references: [id])
  progressos  MetaProgresso[]

  @@index([id_empresa, tipo, ativo])
  @@index([id_empresa, ativo, data_inicio, data_fim])
  @@index([id_pdv])
  @@index([id_funcionario])
}

model MetaProgresso {
  id            String   @id @default(uuid())
  id_meta       String
  id_empresa    String
  periodo       String
  realizado     Float
  atualizado_em DateTime @default(now()) @updatedAt

  meta    Meta    @relation(fields: [id_meta], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [id_empresa], references: [id])

  @@unique([id_meta, periodo])
  @@index([id_empresa, periodo])
}

model Pendencia {
  id            String    @id @default(uuid())
  id_empresa    String
  id_lead       String
  tipo          String
  descricao     String
  documento_url String?
  resolvida     Boolean   @default(false)
  resolvida_em  DateTime?
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @default(now()) @updatedAt
  lead          Lead      @relation(fields: [id_lead], references: [id], onDelete: Cascade)

  @@index([id_empresa])
  @@index([id_lead])
}

model WhatsappInstancia {
  id            String             @id @default(uuid())
  id_empresa    String
  id_criador    String
  nome          String
  instance_name String             @unique
  status        String
  phone         String?
  criado_em     DateTime           @default(now())
  atualizado_em DateTime           @default(now()) @updatedAt
  profile_name  String?
  profile_pic   String?
  mensagens     WhatsappMensagem[]
  pdvs          Pdv[]
  automacao_acoes AutomacaoAcao[]

  @@index([id_empresa])
  @@index([id_criador])
  @@index([id_empresa, instance_name])
  @@index([id_empresa, status])
}

model WhatsappMensagem {
  id                    String @id @default(uuid())
  id_empresa            String
  id_lead               String
  id_whatsapp_instancia String

  mensagem_id    String
  remote_jid     String
  from_me        Boolean
  tipo           String    @default("text")
  conteudo       String?
  status         String    @default("PENDING")
  timestamp      Int
  lida_no_crm_em DateTime?
  erro           String?
  payload_json   String?

  criado_em     DateTime @default(now())
  atualizado_em DateTime @default(now()) @updatedAt

  lead      Lead              @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  instancia WhatsappInstancia @relation(fields: [id_whatsapp_instancia], references: [id], onDelete: Cascade)

  @@unique([id_whatsapp_instancia, mensagem_id])
  @@index([id_empresa, id_lead, timestamp])
  @@index([id_empresa, id_lead, lida_no_crm_em])
  @@index([id_empresa, remote_jid])
}

model CalComInstancia {
  id            String    @id @default(uuid())
  id_empresa    String
  id_criador    String
  nome          String
  api_key       String
  status        String    @default("pending")
  profile_name  String?
  profile_email String?
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @default(now()) @updatedAt

  @@index([id_empresa])
  @@index([id_empresa, status])
}

model LeadEstagioLog {
  id                  String   @id @default(uuid())
  id_lead             String
  id_estagio_anterior  String?
  id_estagio_novo     String
  empresa_id          String
  criado_em           DateTime @default(now())
  lead                Lead     @relation(fields: [id_lead], references: [id], onDelete: Cascade)

  @@index([empresa_id, criado_em])
  @@index([criado_em])
  @@index([id_lead])
}

model Automacao {
  id               String                @id @default(uuid())
  id_empresa       String
  id_criador       String?
  nome             String
  fonte            String
  gatilho          String
  config_json      String                @default("{}")
  ativo            Boolean               @default(true)
  ultimo_sync_em   DateTime              @default(now())
  criado_em        DateTime              @default(now())
  atualizado_em    DateTime              @default(now()) @updatedAt
  empresa          Empresa               @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  acoes            AutomacaoAcao[]
  agendamentos     AutomacaoAgendamento[]

  @@index([id_empresa, ativo])
  @@index([fonte, gatilho])
  @@index([id_empresa])
}

model AutomacaoAcao {
  id                    String              @id @default(uuid())
  id_automacao          String
  tipo                  String
  ordem                 Int
  delay_minutos         Int                 @default(0)
  id_instancia_whatsapp String?
  telefone_destino      String?
  id_lead_destino       String?
  mensagem              String
  automacao             Automacao           @relation(fields: [id_automacao], references: [id], onDelete: Cascade)
  instancia_whatsapp    WhatsappInstancia? @relation(fields: [id_instancia_whatsapp], references: [id], onDelete: SetNull)

  @@unique([id_automacao, ordem])
  @@index([id_automacao])
  @@index([id_instancia_whatsapp])
}

model AutomacaoAgendamento {
  id              String    @id @default(uuid())
  id_automacao    String
  id_lead         String?
  referencia_uid  String    @unique
  tipo_origem     String
  contexto_json   String    @default("{}")
  agendado_para   DateTime
  status          String    @default("PENDENTE")
  tentativas      Int       @default(0)
  erro            String?
  enviado_em      DateTime?
  criado_em       DateTime  @default(now())
  atualizado_em   DateTime  @default(now()) @updatedAt
  automacao       Automacao @relation(fields: [id_automacao], references: [id], onDelete: Cascade)
  lead             Lead?     @relation(fields: [id_lead], references: [id], onDelete: Cascade)

  @@index([status, agendado_para])
  @@index([id_automacao])
  @@index([id_lead])
}

model RegistroIP {
  id            String   @id @default(uuid())
  ip_address    String
  email_hash    String
  id_empresa    String
  user_agent    String?
  criado_em     DateTime @default(now())

  empresa       Empresa  @relation(fields: [id_empresa], references: [id])

  @@unique([ip_address, email_hash])
  @@index([ip_address])
  @@index([email_hash])
  @@index([criado_em])
}
