generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AuditoriaEquipe {
  id                  String   @id
  id_empresa          String
  id_funcionario_alvo String
  acao                String
  campo               String?
  valor_anterior      String?
  valor_novo          String?
  observacao          String?
  autor_tipo          String
  autor_id            String
  criado_em           DateTime @default(now())

  @@index([acao])
  @@index([id_funcionario_alvo])
  @@index([id_empresa])
}

model Automacao {
  id                   String                 @id
  id_empresa           String
  id_criador           String?
  nome                 String
  fonte                String
  gatilho              String
  config_json          String                 @default("{}")
  ativo                Boolean                @default(true)
  ultimo_sync_em       DateTime               @default(now())
  criado_em            DateTime               @default(now())
  atualizado_em        DateTime               @default(now())
  Empresa              Empresa                @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  AutomacaoAcao        AutomacaoAcao[]
  AutomacaoAgendamento AutomacaoAgendamento[]

  @@index([id_empresa])
  @@index([fonte, gatilho])
  @@index([id_empresa, ativo])
}

model AutomacaoAcao {
  id                    String             @id
  id_automacao          String
  tipo                  String
  ordem                 Int
  delay_minutos         Int                @default(0)
  id_instancia_whatsapp String?
  telefone_destino      String?
  id_lead_destino       String?
  mensagem              String
  WhatsappInstancia     WhatsappInstancia? @relation(fields: [id_instancia_whatsapp], references: [id])
  Automacao             Automacao          @relation(fields: [id_automacao], references: [id], onDelete: Cascade)

  @@unique([id_automacao, ordem])
  @@index([id_instancia_whatsapp])
  @@index([id_automacao])
}

model AutomacaoAgendamento {
  id             String    @id
  id_automacao   String
  id_lead        String?
  id_negocio     String?
  referencia_uid String    @unique
  tipo_origem    String
  contexto_json  String    @default("{}")
  agendado_para  DateTime
  status         String    @default("PENDENTE")
  tentativas     Int       @default(0)
  erro           String?
  enviado_em     DateTime?
  criado_em      DateTime  @default(now())
  atualizado_em  DateTime  @default(now())
  Lead           Lead?     @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  Negocio        Negocio?  @relation(fields: [id_negocio], references: [id], onDelete: Cascade)
  Automacao      Automacao @relation(fields: [id_automacao], references: [id], onDelete: Cascade)

  @@index([id_lead])
  @@index([id_negocio])
  @@index([id_automacao])
  @@index([status, agendado_para])
}

model CalComInstancia {
  id            String   @id
  id_empresa    String
  id_criador    String
  nome          String
  api_key       String
  status        String   @default("pending")
  profile_name  String?
  profile_email String?
  criado_em     DateTime @default(now())
  atualizado_em DateTime @default(now())

  @@index([id_empresa, status])
  @@index([id_empresa])
}

model InstagramConta {
  id                  String   @id
  id_empresa          String
  id_criador          String
  nome                String
  instagram_user_id   String
  username            String
  account_type        String?
  profile_picture_url String?
  access_token        String
  token_type          String?
  escopos             String?
  expires_at          DateTime?
  status              String   @default("active")
  criado_em           DateTime @default(now())
  atualizado_em       DateTime @default(now())
  InstagramMensagem   InstagramMensagem[]

  @@unique([id_empresa, instagram_user_id])
  @@index([id_empresa, status])
  @@index([id_empresa])
}

model InstagramMensagem {
  id                  String         @id
  id_empresa          String
  id_instagram_conta  String
  conversation_id     String
  mensagem_id         String
  participant_id      String?
  participant_name    String?
  participant_username String?
  from_me             Boolean
  tipo                String         @default("text")
  conteudo            String?
  timestamp           Int
  payload_json        String?
  erro                String?
  criado_em           DateTime       @default(now())
  atualizado_em       DateTime       @default(now())
  InstagramConta      InstagramConta @relation(fields: [id_instagram_conta], references: [id], onDelete: Cascade)

  @@unique([id_instagram_conta, mensagem_id])
  @@index([id_empresa, conversation_id, timestamp])
  @@index([id_empresa, participant_username])
  @@index([id_instagram_conta, conversation_id])
}

model Empresa {
  id                String           @id
  nome              String
  email             String           @unique
  senha_hash        String
  criado_em         DateTime         @default(now())
  atualizado_em     DateTime         @default(now())
  status_assinatura String           @default("TRIAL")
  trial_inicio      DateTime         @default(now())
  trial_fim         DateTime?
  assinatura_inicio DateTime?
  assinatura_fim    DateTime?
  plano             String           @default("trial")
  Automacao         Automacao[]
  EstagioFunil      EstagioFunil[]
  Funcionario       Funcionario[]
  Funil             Funil[]
  Lead              Lead[]
  LeadProduto       LeadProduto[]
  Negocio           Negocio[]
  NegocioProduto    NegocioProduto[]
  Parcela           Parcela[]
  Pdv               Pdv[]
  Produto           Produto[]
  RegistroIP        RegistroIP[]
}

model Funil {
  id              String              @id
  id_empresa      String
  nome            String
  slug            String
  descricao       String?
  ativo           Boolean             @default(true)
  padrao          Boolean             @default(false)
  ordem           Int                 @default(0)
  criado_em       DateTime            @default(now())
  atualizado_em   DateTime            @default(now())
  Empresa         Empresa             @relation(fields: [id_empresa], references: [id])
  EstagioFunil    EstagioFunil[]
  Negocio         Negocio[]
  logs_anteriores NegocioEstagioLog[] @relation("NegocioLogFunilAnterior")
  logs_novos      NegocioEstagioLog[] @relation("NegocioLogFunilNovo")

  @@unique([id_empresa, slug])
  @@index([id_empresa])
  @@index([id_empresa, padrao])
}

model EstagioFunil {
  id              String              @id
  id_empresa      String
  id_funil        String
  nome            String
  ordem           BigInt
  tipo            String
  criado_em       DateTime            @default(now())
  atualizado_em   DateTime            @default(now())
  Empresa         Empresa             @relation(fields: [id_empresa], references: [id])
  Funil           Funil               @relation(fields: [id_funil], references: [id])
  Lead            Lead[]
  Negocio         Negocio[]
  logs_anteriores NegocioEstagioLog[] @relation("NegocioLogEstagioAnterior")
  logs_novos      NegocioEstagioLog[] @relation("NegocioLogEstagioNovo")

  @@unique([id_funil, ordem])
  @@index([id_empresa])
  @@index([id_funil])
}

model Funcionario {
  id            String    @id
  id_empresa    String
  id_pdv        String
  nome          String
  email         String    @unique
  senha_hash    String
  cargo         String
  ativo         Boolean   @default(true)
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @default(now())
  inativado_em  DateTime?
  Empresa       Empresa   @relation(fields: [id_empresa], references: [id])
  Pdv           Pdv       @relation(fields: [id_pdv], references: [id])
  Lead          Lead[]
  Negocio       Negocio[]

  @@index([id_pdv])
  @@index([id_empresa])
}

model Lead {
  id                   String                 @id
  id_empresa           String
  id_funcionario       String
  id_pdv               String?
  id_negocio           String?
  id_estagio           String
  nome                 String
  telefone             String
  email                String?
  valor_oportunidade   Float                  @default(0)
  probabilidade        Float                  @default(0.5)
  fonte                String?
  empresa_origem       String?
  observacoes          String?
  motivo_perda         String?
  criado_em            DateTime               @default(now())
  atualizado_em        DateTime               @default(now())
  origem               String                 @default("MANUAL")
  anuncio_titulo       String?
  anuncio_descricao    String?
  anuncio_url          String?
  dados_extras         String?
  ativo                Boolean                @default(true)
  AutomacaoAgendamento AutomacaoAgendamento[]
  Empresa              Empresa                @relation(fields: [id_empresa], references: [id])
  Funcionario          Funcionario            @relation(fields: [id_funcionario], references: [id])
  Negocio              Negocio?               @relation("LeadOwnership", fields: [id_negocio], references: [id], onDelete: SetNull)
  EstagioFunil         EstagioFunil           @relation(fields: [id_estagio], references: [id])
  LeadEstagioLog       LeadEstagioLog[]
  LeadProduto          LeadProduto[]
  NegociosComoPrincipal Negocio[]             @relation("NegocioLeadPrincipal")
  Parcela              Parcela[]
  Pendencia            Pendencia[]
  WhatsappMensagem     WhatsappMensagem[]

  @@index([id_empresa, email])
  @@index([id_estagio])
  @@index([id_funcionario])
  @@index([id_pdv])
  @@index([id_negocio])
  @@index([id_empresa])
  @@index([id_empresa, ativo])
}

model Negocio {
  id                     String                 @id
  id_empresa             String
  id_lead                String?
  id_funil               String
  id_estagio             String
  id_funcionario         String
  id_produto_principal   String?
  titulo                 String
  valor_estimado         Float                  @default(0)
  valor_fechado          Float?
  probabilidade          Float?
  status                 String                 @default("ABERTO")
  data_abertura          DateTime
  data_fechamento        DateTime?
  motivo_perda           String?
  observacoes_comerciais String?
  chave_migracao         String?                @unique
  criado_em              DateTime               @default(now())
  atualizado_em          DateTime               @default(now())
  Empresa                Empresa                @relation(fields: [id_empresa], references: [id])
  Lead                   Lead?                  @relation("NegocioLeadPrincipal", fields: [id_lead], references: [id], onDelete: SetNull)
  Leads                  Lead[]                 @relation("LeadOwnership")
  Funil                  Funil                  @relation(fields: [id_funil], references: [id])
  EstagioFunil           EstagioFunil           @relation(fields: [id_estagio], references: [id])
  Funcionario            Funcionario            @relation(fields: [id_funcionario], references: [id])
  ProdutoPrincipal       Produto?               @relation("NegocioProdutoPrincipal", fields: [id_produto_principal], references: [id], onDelete: SetNull)
  Parcela                Parcela[]
  NegocioProduto         NegocioProduto[]
  NegocioEstagioLog      NegocioEstagioLog[]
  AutomacaoAgendamento   AutomacaoAgendamento[]

  @@index([id_empresa, id_lead])
  @@index([id_empresa, id_funcionario])
  @@index([id_empresa, id_funil, id_estagio])
  @@index([id_empresa, status])
  @@index([id_lead, criado_em])
}

model LeadEstagioLog {
  id                  String   @id
  id_lead             String
  id_estagio_anterior String?
  id_estagio_novo     String
  empresa_id          String
  criado_em           DateTime @default(now())
  Lead                Lead     @relation(fields: [id_lead], references: [id], onDelete: Cascade)

  @@index([id_lead])
  @@index([criado_em])
  @@index([empresa_id, criado_em])
}

model LeadProduto {
  id              String   @id
  id_empresa      String
  id_lead         String
  id_produto      String
  nome_snapshot   String
  schema_snapshot String
  valores_layout  String
  observacoes     String?
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @default(now())
  Produto         Produto  @relation(fields: [id_produto], references: [id])
  Lead            Lead     @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  Empresa         Empresa  @relation(fields: [id_empresa], references: [id])

  @@index([id_produto])
  @@index([id_lead])
  @@index([id_empresa])
}

model MensagemAgendada {
  id               String   @id
  id_empresa       String
  id_lead          String?
  instance_name    String
  remote_jid       String
  conteudo         String
  tipo             String   @default("text")
  agendado_para    DateTime
  status           String   @default("PENDENTE")
  tentativas       Int      @default(0)
  erro             String?
  enviado_em       DateTime?
  mensagem_id      String?
  criado_por       String
  criado_em        DateTime @default(now())
  atualizado_em    DateTime @default(now())

  @@index([id_empresa, status, agendado_para])
  @@index([instance_name, remote_jid])
  @@index([status, agendado_para])
}

model NegocioEstagioLog {
  id                  String        @id
  id_negocio          String
  id_funil_anterior   String?
  id_funil_novo       String
  id_estagio_anterior String?
  id_estagio_novo     String
  empresa_id          String
  origem              String        @default("KANBAN")
  criado_em           DateTime      @default(now())
  Negocio             Negocio       @relation(fields: [id_negocio], references: [id], onDelete: Cascade)
  FunilAnterior       Funil?        @relation("NegocioLogFunilAnterior", fields: [id_funil_anterior], references: [id])
  FunilNovo           Funil         @relation("NegocioLogFunilNovo", fields: [id_funil_novo], references: [id])
  EstagioAnterior     EstagioFunil? @relation("NegocioLogEstagioAnterior", fields: [id_estagio_anterior], references: [id])
  EstagioNovo         EstagioFunil  @relation("NegocioLogEstagioNovo", fields: [id_estagio_novo], references: [id])

  @@index([empresa_id, criado_em])
  @@index([criado_em])
  @@index([id_negocio])
}

model NegocioProduto {
  id              String   @id
  id_empresa      String
  id_negocio      String
  id_produto      String
  nome_snapshot   String
  schema_snapshot String
  valores_layout  String
  observacoes     String?
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @default(now())
  Produto         Produto  @relation(fields: [id_produto], references: [id])
  Negocio         Negocio  @relation(fields: [id_negocio], references: [id], onDelete: Cascade)
  Empresa         Empresa  @relation(fields: [id_empresa], references: [id])

  @@index([id_produto])
  @@index([id_negocio])
  @@index([id_empresa])
}

model Parcela {
  id               String    @id
  id_empresa       String
  id_lead          String
  id_negocio       String?
  numero_parcela   Int
  quantidade_total Int
  valor            Float
  data_vencimento  DateTime
  data_pagamento   DateTime?
  status           String    @default("PENDENTE")
  criado_em        DateTime  @default(now())
  atualizado_em    DateTime  @default(now())
  Empresa          Empresa   @relation(fields: [id_empresa], references: [id])
  Lead             Lead      @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  Negocio          Negocio?  @relation(fields: [id_negocio], references: [id], onDelete: Cascade)

  @@unique([id_lead, numero_parcela])
  @@index([id_empresa, data_vencimento])
  @@index([id_empresa, status])
  @@index([id_lead])
  @@index([id_negocio])
  @@index([id_empresa])
}

model Pdv {
  id                    String             @id
  id_empresa            String
  id_whatsapp_instancia String?
  nome                  String
  criado_em             DateTime           @default(now())
  atualizado_em         DateTime           @default(now())
  Funcionario           Funcionario[]
  WhatsappInstancia     WhatsappInstancia? @relation(fields: [id_whatsapp_instancia], references: [id])
  Empresa               Empresa            @relation(fields: [id_empresa], references: [id])

  @@index([id_empresa, id_whatsapp_instancia])
  @@index([id_empresa])
}

model Pendencia {
  id            String    @id
  id_empresa    String
  id_lead       String
  tipo          String
  descricao     String
  documento_url String?
  resolvida     Boolean   @default(false)
  resolvida_em  DateTime?
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @default(now())
  Lead          Lead      @relation(fields: [id_lead], references: [id], onDelete: Cascade)

  @@index([id_lead])
  @@index([id_empresa])
}

model Produto {
  id               String           @id
  id_empresa       String
  nome             String
  slug             String
  descricao        String?
  ativo            Boolean          @default(true)
  schema_layout    String
  criado_em        DateTime         @default(now())
  atualizado_em    DateTime         @default(now())
  LeadProduto      LeadProduto[]
  NegocioProduto   NegocioProduto[]
  NegocioPrincipal Negocio[]        @relation("NegocioProdutoPrincipal")
  Empresa          Empresa          @relation(fields: [id_empresa], references: [id])

  @@unique([id_empresa, slug])
  @@index([id_empresa, ativo])
  @@index([id_empresa])
}

model ReatribuicaoFuncionario {
  id                     String   @id
  id_empresa             String
  id_funcionario_origem  String
  id_funcionario_destino String
  quantidade_leads       Int
  observacao             String?
  criado_por_tipo        String
  criado_por_id          String
  criado_em              DateTime @default(now())

  @@index([id_funcionario_destino])
  @@index([id_funcionario_origem])
  @@index([id_empresa])
}

model RegistroIP {
  id         String   @id
  ip_address String
  email_hash String
  id_empresa String
  user_agent String?
  criado_em  DateTime @default(now())
  Empresa    Empresa  @relation(fields: [id_empresa], references: [id])

  @@unique([ip_address, email_hash])
  @@index([criado_em])
  @@index([email_hash])
  @@index([ip_address])
}

model WhatsappInstancia {
  id               String             @id
  id_empresa       String
  id_criador       String
  nome             String
  instance_name    String             @unique
  status           String
  phone            String?
  criado_em        DateTime           @default(now())
  atualizado_em    DateTime           @default(now())
  profile_name     String?
  profile_pic      String?
  AutomacaoAcao    AutomacaoAcao[]
  Pdv              Pdv[]
  WhatsappMensagem WhatsappMensagem[]

  @@index([id_empresa, status])
  @@index([id_empresa, instance_name])
  @@index([id_criador])
  @@index([id_empresa])
}

model WhatsappMensagem {
  id                    String            @id
  id_empresa            String
  id_lead               String
  id_whatsapp_instancia String
  mensagem_id           String
  remote_jid            String
  remote_jid_alt        String?
  from_me               Boolean
  tipo                  String            @default("text")
  conteudo              String?
  push_name             String?
  status                String            @default("PENDING")
  timestamp             Int
  lida_no_crm_em        DateTime?
  erro                  String?
  payload_json          String?
  criado_em             DateTime          @default(now())
  atualizado_em         DateTime          @default(now())
  WhatsappInstancia     WhatsappInstancia @relation(fields: [id_whatsapp_instancia], references: [id], onDelete: Cascade)
  Lead                  Lead              @relation(fields: [id_lead], references: [id], onDelete: Cascade)

  @@unique([id_whatsapp_instancia, mensagem_id])
  @@index([id_empresa, remote_jid])
  @@index([id_empresa, id_lead, lida_no_crm_em])
  @@index([id_empresa, id_lead, timestamp])
}
